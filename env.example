# Variables de entorno para el proyecto
# Copia este archivo como .env.local y configura los valores
# Las variables reales están configuradas en Vercel

# Opcional en local: URL completa de endpoint de contacto
# (si lo dejas vacío, el frontend usa /api/contact)
VITE_CONTACT_API_URL=

# Variables seguras para el cliente (con VITE_)
# Site key de hCaptcha (captcha)
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key


# Variables de servidor para /api/contact (NO usar prefijo VITE_)

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=info@tudominio.com
CONTACT_FROM_EMAIL=contacto@tudominio.com
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret


# ID de Google Analytics
VITE_GA_ID=your-ga-id-here
# URL base del sitio
VITE_SITE_URL=https://www.bmontero.com
# Modo desarrollo (true/false)
VITE_DEV_MODE=false
# URL base del API del blog en radar (solo servidor, para las rutas API de Vercel en producción). No se expone al cliente.
BLOG_API_URL=https://radar.bmontero.com/api
